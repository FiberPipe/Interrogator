{
  "name": "@interrogator/app",
  "private": true,
  "version": "1.0.0",
  "main": "build/src/app/electron/main.js",
  "scripts": {
    "dev:react": "rsbuild dev --port 3000",
    "dev:web": "npm run dev:react -- --open",
    "dev:electron": "concurrently \"pnpm dev:react\" \"wait-on http://127.0.0.1:3000 && tsc -p ./src/app/electron/ -w\" \"wait-on http://127.0.0.1:3000 && tsc -p ./src/app/electron/ && electron .\"",
    "dev": "npm run dev:web",
    "build:web": "rsbuild build",
    "build:electron": "npm run build:web && tsc -p ./src/app/electron/ && electron-builder",
    "build:win": "npm run build:web && tsc -p ./src/app/electron/ && electron-builder --win --x64"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@heroui/react": "2.8.4",
    "@heroui/system": "2.4.22",
    "@heroui/theme": "2.4.22",
    "@nivo/line": "0.99.0",
    "@rsbuild/plugin-sass": "1.3.3",
    "bem-cn-lite": "4.1.0",
    "echarts": "6.0.0",
    "electron-store": "11.0.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-router-dom": "^7.9.3",
    "serialport": "13.0.0",
    "zustand": "5.0.8"
  },
  "devDependencies": {
    "@gravity-ui/icons": "2.16.0",
    "@rsbuild/core": "1.5.12",
    "@rsbuild/plugin-react": "1.4.1",
    "@tailwindcss/postcss": "4.1.13",
    "@types/node": "24.5.2",
    "@types/react": "^19.1.14",
    "@types/react-dom": "^19.1.9",
    "autoprefixer": "10.4.21",
    "concurrently": "9.2.1",
    "electron": "38.1.2",
    "electron-builder": "26.0.12",
    "electronmon": "2.0.3",
    "framer-motion": "^12.23.22",
    "postcss": "^8.5.6",
    "postcss-loader": "^8.2.0",
    "tailwindcss": "^4.1.13",
    "typescript": "^5.9.2",
    "wait-on": "9.0.1"
  },
  "build": {
    "extends": null,
    "files": [
      "build/**/*"
    ],
    "directories": {
      "buildResources": "assets"
    }
  }
}