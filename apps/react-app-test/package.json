{
  "name": "my-electron-app",
  "version": "1.0.0",
  "private": true,
  "main": "dist/renderer/src/electron/main.js",
  "scripts": {
    "dev:web": "rsbuild dev --port 3000",
    "dev:electron": "NODE_ENV=development concurrently \"pnpm dev:web\" \"wait-on http://127.0.0.1:3000 && tsc -p ./src/electron/ -w\" \"wait-on http://127.0.0.1:3000 && tsc -p ./src/electron/ && electron .\"",
    "build:web": "rsbuild build",
    "build:electron": "NODE_ENV=production && tsc -p . && electron-builder",
    "build:win": "pnpm build:web && pnpm build:electron --win"
  },
  "dependencies": {
    "@emotion/react": "11.13.0",
    "@emotion/styled": "11.13.0",
    "@gravity-ui/icons": "2.16.0",
    "@heroui/react": "2.8.5",
    "@serialport/parser-readline": "13.0.0",
    "@tailwindcss/postcss": "^4.1.16",
    "autoprefixer": "^10.4.21",
    "bem-cn-lite": "4.1.0",
    "echarts": "5.6.0",
    "electron-store": "10.1.0",
    "react": "^18.3.1",
    "react-dom": "18.3.1",
    "react-router-dom": "6.25.0",
    "recharts": "3.3.0",
    "serialport": "11.0.0",
    "tailwindcss": "^4.1.16",
    "zustand": "^4.5.4"
  },
  "devDependencies": {
    "@rsbuild/core": "^1.5.17",
    "@rsbuild/plugin-react": "^1.4.1",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "concurrently": "^9.0.1",
    "electron": "^32.3.3",
    "electron-builder": "^26.0.12",
    "typescript": "^5.5.2",
    "wait-on": "^7.2.0"
  },
  "build": {
    "appId": "com.example.myelectronapp",
    "productName": "MyElectronApp",
    "directories": {
      "output": "release",
      "buildResources": "assets"
    },
    "files": [
      "dist/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "assets/icon.ico"
    }
  }
}
