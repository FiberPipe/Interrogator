{
  "name": "@interrogator/app",
  "private": true,
  "version": "1.0.0",
  "description": "FBG Sensor Interrogator Desktop Application",
  "author": "Your Name",
  "main": "build/electron/main.js",
  "scripts": {
    "dev:react": "rsbuild dev --port 3000",
    "dev:web": "npm run dev:react -- --open",
    "dev:electron": "concurrently \"pnpm dev:react\" \"wait-on http://127.0.0.1:3000 && tsc -p tsconfig.electron.json -w\" \"wait-on http://127.0.0.1:3000 && tsc -p tsconfig.electron.json && electron .\"",
    "prepare:build": "node scripts/prepare-build.js",
    "build:web": "rsbuild build",
    "build:electron": "tsc -p tsconfig.electron.json",
    "build:core": "npm run prepare:build && npm run prebuild && npm run build:web && npm run build:electron",
    "build": "node scripts/build.js",
    "build:alpha": "node scripts/build.js --channel=alpha",
    "build:beta": "node scripts/build.js --channel=beta",
    "build:dev": "node scripts/build.js --dev",
    "build:quick": "node scripts/build.js --skip-clean --skip-rebuild",
    "dist": "npm run build",
    "dist:alpha": "npm run build:alpha",
    "dist:beta": "npm run build:beta",
    "dist:quick": "npm run build:quick",
    "version:info": "node scripts/version-manager.js info",
    "version:sync": "node scripts/version-manager.js sync",
    "version:bump": "node scripts/version-manager.js bump",
    "version:bump:alpha": "node scripts/version-manager.js bump alpha",
    "version:bump:beta": "node scripts/version-manager.js bump beta",
    "version:bump:alpha:minor": "node scripts/version-manager.js bump alpha minor",
    "version:bump:alpha:major": "node scripts/version-manager.js bump alpha major",
    "version:bump:beta:minor": "node scripts/version-manager.js bump beta minor",
    "version:bump:beta:major": "node scripts/version-manager.js bump beta major",
    "version:promote": "node scripts/version-manager.js promote",
    "postinstall": "electron-builder install-app-deps",
    "clean": "rimraf build dist",
    "clean:build": "node scripts/prepare-build.js",
    "clean:modules": "rimraf node_modules pnpm-lock.yaml",
    "clean:install": "npm run clean:modules && pnpm install",
    "clean:all": "npm run clean && npm run clean:modules",
    "lint": "eslint 'src/**/*.{ts,tsx}'",
    "lint:fix": "eslint 'src/**/*.{ts,tsx}' --fix",
    "format:check": "prettier --check 'src/**/*.{ts,tsx,js,jsx,json,css,md}'",
    "format:fix": "prettier --write 'src/**/*.{ts,tsx,js,jsx,json,css,md}'",
    "prepare": "husky",
    "assets:create": "node scripts/create-icons.js",
    "assets:check": "node scripts/check-assets.js",
    "assets:placeholder": "node scripts/create-placeholder-assets.js",
    "prebuild": "npm run assets:check && node scripts/prebuild.js"
  },
  "dependencies": {
    "@heroui/react": "2.8.4",
    "@heroui/system": "2.4.22",
    "@heroui/theme": "2.4.22",
    "@monaco-editor/react": "^4.7.0",
    "@rsbuild/plugin-node-polyfill": "^1.4.2",
    "drizzle-orm": "0.44.7",
    "electron-store": "8.2.0",
    "i18next": "25.7.1",
    "i18next-browser-languagedetector": "8.2.0",
    "lucide-react": "0.554.0",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "react-i18next": "^16.3.5",
    "react-router-dom": "^7.9.6",
    "recharts": "3.5.1",
    "serialport": "13.0.0",
    "sql.js": "^1.13.0",
    "tailwindcss": "^4.1.17"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@rsbuild/core": "1.5.12",
    "@rsbuild/plugin-react": "1.4.1",
    "@tailwindcss/postcss": "4.1.13",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "24.5.2",
    "@types/react": "19.1.14",
    "@types/react-dom": "19.1.9",
    "@types/sql.js": "^1.4.9",
    "@typescript-eslint/eslint-plugin": "^8.48.1",
    "@typescript-eslint/parser": "^8.48.1",
    "autoprefixer": "10.4.21",
    "better-sqlite3": "^12.5.0",
    "concurrently": "9.2.1",
    "date-fns": "^4.1.0",
    "electron": "39.2.4",
    "electron-builder": "26.0.12",
    "eslint": "9.39.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-prettier": "^5.5.4",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "framer-motion": "^12.26.1",
    "globals": "^16.5.0",
    "husky": "^9.1.7",
    "jiti": "^2.6.1",
    "lint-staged": "^16.2.7",
    "motion": "^12.26.1",
    "prettier": "^3.7.3",
    "rimraf": "^6.1.2",
    "typescript": "5.9.2",
    "typescript-eslint": "^8.48.1",
    "wait-on": "9.0.1"
  },
  "build": {
    "appId": "com.interrogator.app",
    "productName": "Interrogator",
    "artifactName": "${productName}-${channel}-${version}-Setup.${ext}",
    "npmRebuild": false,
    "files": [
      "build/**/*",
      "!build/renderer/**/*.map",
      "node_modules/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "node_modules/sql.js/dist/sql-wasm.wasm",
        "to": "sql-wasm.wasm"
      }
    ],
    "directories": {
      "buildResources": "assets",
      "output": "dist"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.ico",
      "requestedExecutionLevel": "asInvoker",
      "artifactName": "${productName}-${channel}-${version}-Setup.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true,
      "installerIcon": "assets/installer-icon.ico",
      "uninstallerIcon": "assets/uninstaller-icon.ico",
      "installerHeader": "assets/installer-header.bmp",
      "installerHeaderIcon": "assets/icon.ico",
      "installerSidebar": "assets/installer-sidebar.bmp",
      "uninstallerSidebar": "assets/uninstaller-sidebar.bmp",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "${productName}",
      "include": "scripts/installer.nsh",
      "warningsAsErrors": false,
      "runAfterFinish": true,
      "menuCategory": true,
      "displayLanguageSelector": false,
      "installerLanguages": [
        "en_US",
        "ru_RU"
      ],
      "language": "1033",
      "multiLanguageInstaller": true,
      "deleteAppDataOnUninstall": false,
      "packElevateHelper": true,
      "perMachineInstallation": false,
      "oneClickInstall": false,
      "guid": "a1b2c3d4-e5f6-4a5b-8c9d-0e1f2a3b4c5d"
    },
    "asarUnpack": [
      "**/node_modules/serialport/**/*",
      "**/node_modules/@serialport/**/*",
      "**/node_modules/better-sqlite3/**/*",
      "**/node_modules/sql.js/**/*"
    ],
    "publish": null
  }
}