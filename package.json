{
  "name": "@interrogator/app",
  "private": true,
  "version": "1.0.0",
  "main": "build/electron/main.js",
  "scripts": {
    "dev:react": "rsbuild dev --port 3000",
    "dev:web": "npm run dev:react -- --open",
    "dev:electron": "concurrently \"pnpm dev:react\" \"wait-on http://127.0.0.1:3000 && tsc -p tsconfig.electron.json -w\" \"wait-on http://127.0.0.1:3000 && tsc -p tsconfig.electron.json && electron .\"",
    "build:web": "rsbuild build",
    "build:electron": "tsc -p tsconfig.electron.json && cp electron.cjs.package.json build/electron/package.json",
    "build": "npm run build:web && npm run build:electron",
    "dist": "npm run build && electron-builder",
    "lint": "eslint 'src/**/*.{ts,tsx}'",
    "lint:fix": "eslint 'src/**/*.{ts,tsx}' --fix",
    "format:check": "prettier --check 'src/**/*.{ts,tsx,js,jsx,json,css,md}'",
    "format:fix": "prettier --write 'src/**/*.{ts,tsx,js,jsx,json,css,md}'"
  },
  "dependencies": {
    "@heroui/react": "2.8.4",
    "@heroui/system": "2.4.22",
    "@heroui/theme": "2.4.22",
    "drizzle-orm": "^0.44.7",
    "electron-store": "^8.2.0",
    "lucide-react": "^0.554.0",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "react-router-dom": "^7.9.6",
    "recharts": "^3.5.1",
    "serialport": "13.0.0",
    "tailwindcss": "^4.1.17"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@rsbuild/core": "1.5.12",
    "@rsbuild/plugin-react": "1.4.1",
    "@tailwindcss/postcss": "4.1.13",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "24.5.2",
    "@types/react": "19.1.14",
    "@types/react-dom": "19.1.9",
    "@typescript-eslint/eslint-plugin": "^8.48.1",
    "@typescript-eslint/parser": "^8.48.1",
    "autoprefixer": "10.4.21",
    "better-sqlite3": "^12.5.0",
    "concurrently": "9.2.1",
    "electron": "39.2.4",
    "electron-builder": "26.0.12",
    "eslint": "^9.39.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-prettier": "^5.5.4",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "globals": "^16.5.0",
    "jiti": "^2.6.1",
    "prettier": "^3.7.3",
    "typescript": "5.9.2",
    "typescript-eslint": "^8.48.1",
    "wait-on": "9.0.1"
  },
  "build": {
    "files": [
      "build/**/*"
    ],
    "directories": {
      "buildResources": "assets"
    }
  }
}