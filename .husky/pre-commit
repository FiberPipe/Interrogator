ask_skip() {
  step_name="$1"
  while true; do
    # Спрашиваем пользователя
    printf "❌ %s failed. Пропустить и продолжить коммит? (y/N): " "$step_name"
    read answer

    case "$answer" in
      [Yy]* ) 
        echo "⚠️  Пропускаем $step_name"
        return 0
        ;;
      [Nn]* | "" )
        echo "❌ Commit заблокирован из-за $step_name"
        exit 1
        ;;
      * )
        echo "Пожалуйста, введите y или n"
        ;;
    esac
  done
}

run_step() {
  step_name="$1"
  shift
  echo "\n🚀 Запускаем $step_name..."
  "$@"
  status=$?

  if [ $status -ne 0 ]; then
    ask_skip "$step_name"
  else
    echo "✅ $step_name прошёл успешно"
  fi
}

# --- Шаги ---
run_step "i18n check" pnpm check:i18n
run_step "lint" pnpm lint

echo "\n🎉 Все pre-commit шаги завершены"
