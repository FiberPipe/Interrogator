#!/usr/bin/env sh
. "$(dirname "$0")/_/husky.sh"

echo "🔍 Запускаем прекоммит-проверки…"

# 1. Проверяем staged-файлы ESLint/Prettier
npx lint-staged
STATUS=$?

if [ $STATUS -ne 0 ]; then
  echo "❌ Ошибка в линтинге / форматировании"
  exit 1
fi

# 2. TypeScript type-check (полный)
echo "🔎 Проверяем типы…"
pnpm tsc -p tsconfig.base.json --noEmit
STATUS=$?

if [ $STATUS -ne 0 ]; then
  echo "❌ Ошибки TypeScript"
  exit 1
fi

echo "✅ Все проверки прошли успешно!"
