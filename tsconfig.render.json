{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "module": "ESNext",
    "jsx": "react-jsx",
    "moduleResolution": "bundler",
    "isolatedModules": true,
    "noEmit": true,
    "target": "ES2020",
    "esModuleInterop": true
  },
  "include": [
    "src/app/**/*",
    "src/features/**/*",
    "src/entities/**/*",
    "src/widgets/**/*",
    "src/shared/**/*"
  ],
  "exclude": [
    "node_modules",
    "build",
    "dist",
    "src/electron/**/*"
  ]
}
