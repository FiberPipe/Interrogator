{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "module": "ESNext",
    "jsx": "react-jsx",
    "moduleResolution": "bundler",
    "isolatedModules": true,
    "noEmit": true,
    "target": "ES2020",
    "esModuleInterop": true,
  },
  "include": ["src/app/**/*", "src/types/**/*"]
}
